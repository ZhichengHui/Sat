    let mut s = Cdcl_mk { Cdcl_pa: Pasn_mk { Pasn_assign: Assignments_mk(vec_from_elem(false, n)), Pasn_set: vec_from_elem(false, n) }, Cdcl_level: vec_from_elem(0_usize, n), Cdcl_reason: vec_from_elem(NONE(), n), Cdcl_trail: { let res_1 = []; \<llangle>res_1 :: (64 word) list\<rrangle> }, Cdcl_qhead: 0_usize, Cdcl_db: { let res_2 = []; \<llangle>res_2 :: Clause list\<rrangle> }, Cdcl_watches: vec_from_elem({ let res_3 = []; \<llangle>res_3 :: (64 word) list\<rrangle> }, 2_usize * n), Cdcl_dl: 0_usize };
    let mut confl = NONE();
    let mut i = 0_usize;
    #[fuel(\<epsilon>\<open>urust_fuel\<close>)] while (* i) < len(f.Formula_clauses) {
      match normalize(f.Formula_clauses[* i]) {
        None \<Rightarrow> {
          ()
        },
        Some(c) \<Rightarrow> {
          if len(c.Clause_v0) == 0_usize {
            return Some(Answer_Unsat);
          };
          if len(c.Clause_v0) == 1_usize {
            let l = c.Clause_v0[0_usize];
            let r = len(* (s.Cdcl_db));
            vec_push(s.Cdcl_db, c);
            if !((* (s.Cdcl_pa.Pasn_set))[l.Lit_var]) {
              Cdcl_enqueue(s, l, r);
            } else {
              if ((* (s.Cdcl_pa.Pasn_assign.Assignments_v0))[l.Lit_var]) != (l.Lit_value) {
                * confl = r;
              }
            }
          } else {
            let _ = Cdcl_add_clause(s, c);
            ()
          }
        }
      };
      * i += 1_usize;
    };
    #[fuel(\<epsilon>\<open>urust_fuel\<close>)] loop {
      if (* confl) == NONE() {
        * confl = Cdcl_propagate(s);
      };
      if (* confl) != NONE() {
        let cl = Cdcl_analyze(* s, * confl);
        * confl = NONE();
        if len(cl) == 0_usize {
          return Some(Answer_Unsat);
        };
        if ((* (s.Cdcl_dl)) == 0_usize) || (len(cl) > n) {
          return None;
        };
        Cdcl_learn(s, cl);
        continue;
      };
      let v = Cdcl_pick(* s);
      if v == NONE() {
        if Formula_conflict(f, * (s.Cdcl_pa)) {
          return None;
        };
        return Some(Answer_Sat_mk(* (s.Cdcl_pa.Pasn_assign)));
      };
      if (* (s.Cdcl_dl)) >= n {
        return None;
      };
      * (s.Cdcl_dl) += 1_usize;
      Cdcl_enqueue(s, Lit_mk { Lit_var: v, Lit_value: false }, NONE());
    };
    panic!("unreachable: diverging expression completed")
  \<rbrakk>\<close>

(* Rust: solver *)
definition "solver" :: \<open>Formula \<Rightarrow> ('s, Answer, 'abort, 'i prompt, 'o prompt_output) function_body\<close> where
  \<open>solver \<equiv> \<lambda>f. FunctionBody \<lbrakk>
    match cdcl(f) {
      Some(a) \<Rightarrow> {
        a
      },
      None \<Rightarrow> {
        solve(f, Pasn_mk { Pasn_assign: Assignments_mk(vec_from_elem(false, f.Formula_num_vars)), Pasn_set: vec_from_elem(false, f.Formula_num_vars) })
      }
    }
  \<rbrakk>\<close>

